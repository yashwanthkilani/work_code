merge INTO T_EDC_RPT_GOOGLE_TZ_INFO t1 USING (
  SELECT
    g_address_components_locality,
    g_address_components_administrative_area_level_1,
    g_address_components_country,
    g_address_components_postal_code,
    g_formatted_address,
    g_geometry_bounds_northeast_lat,
    g_geometry_bounds_northeast_lng,
    g_geometry_bounds_southwest_lat,
    g_geometry_bounds_southwest_lng,
    g_geometry_location_lat,
    g_geometry_location_lng,
    g_geometry_location_type,
    g_geometry_viewport_northeast_lat,
    g_geometry_viewport_northeast_lng,
    g_geometry_viewport_southwest_lat,
    g_geometry_viewport_southwest_lng,
    g_place_id,
    g_types,
    study_num,
    site_num,
    systimestamp AS NABU_UPDT_TS
  FROM
    T_EDC_RPT_GOOGLE_TZ_INFO_STG
) t2 ON (
  t1.study_num = t2.study_num
  AND t1.site_num = t2.site_num
) WHEN matched THEN
UPDATE
SET
  t1.g_address_components_locality = t2.g_address_components_locality,
  t1.g_address_components_administrative_area_level_1 = t2.g_address_components_administrative_area_level_1,
  t1.g_address_components_country = t2.g_address_components_country,
  t1.g_address_components_postal_code = t2.g_address_components_postal_code,
  t1.g_formatted_address = t2.g_formatted_address,
  t1.g_geometry_bounds_northeast_lat = t2.g_geometry_bounds_northeast_lat,
  t1.g_geometry_bounds_northeast_lng = t2.g_geometry_bounds_northeast_lng,
  t1.g_geometry_bounds_southwest_lat = t2.g_geometry_bounds_southwest_lat,
  t1.g_geometry_bounds_southwest_lng = t2.g_geometry_bounds_southwest_lng,
  t1.g_geometry_location_lat = t2.g_geometry_location_lat,
  t1.g_geometry_location_lng = t2.g_geometry_location_lng,
  t1.g_geometry_location_type = t2.g_geometry_location_type,
  t1.g_geometry_viewport_northeast_lat = t2.g_geometry_viewport_northeast_lat,
  t1.g_geometry_viewport_northeast_lng = t2.g_geometry_viewport_northeast_lng,
  t1.g_geometry_viewport_southwest_lat = t2.g_geometry_viewport_southwest_lat,
  t1.g_geometry_viewport_southwest_lng = t2.g_geometry_viewport_southwest_lng,
  t1.g_place_id = t2.g_place_id,
  t1.g_types = t2.g_types,
  t1.nabu_updt_ts = t2.nabu_updt_ts
WHERE
  NOT (
    t2."STUDY_NUM" IS NULL
    AND t2."SITE_NUM" IS NULL
  )